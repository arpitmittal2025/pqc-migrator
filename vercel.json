{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "outputDirectory": "public",
  "buildCommand": null,
  "installCommand": null,
  "functions": {
    "api/analyze.py": {
      "memory": 1024,
      "maxDuration": 60,
      "includeFiles": "{pqc_migrator,samples}/**"
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
